<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af"/>
      <stop offset="100%" style="stop-color:#7c3aed"/>
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#60a5fa"/>
      <stop offset="100%" style="stop-color:#a78bfa"/>
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="96" fill="url(#bg)"/>
  <!-- Dumbbell -->
  <rect x="120" y="230" width="272" height="52" rx="26" fill="url(#glow)" opacity="0.9"/>
  <rect x="90" y="190" width="60" height="132" rx="16" fill="#f1f5f9"/>
  <rect x="362" y="190" width="60" height="132" rx="16" fill="#f1f5f9"/>
  <rect x="70" y="210" width="40" height="92" rx="12" fill="#e2e8f0"/>
  <rect x="402" y="210" width="40" height="92" rx="12" fill="#e2e8f0"/>
  <!-- AI Circuit dots -->
  <circle cx="256" cy="140" r="8" fill="#60a5fa"/>
  <circle cx="220" cy="120" r="5" fill="#a78bfa"/>
  <circle cx="292" cy="120" r="5" fill="#a78bfa"/>
  <circle cx="256" cy="372" r="8" fill="#60a5fa"/>
  <circle cx="220" cy="392" r="5" fill="#a78bfa"/>
  <circle cx="292" cy="392" r="5" fill="#a78bfa"/>
  <line x1="256" y1="148" x2="256" y2="230" stroke="#60a5fa" stroke-width="2" opacity="0.5"/>
  <line x1="256" y1="282" x2="256" y2="364" stroke="#60a5fa" stroke-width="2" opacity="0.5"/>
  <line x1="220" y1="125" x2="256" y2="140" stroke="#a78bfa" stroke-width="1.5" opacity="0.5"/>
  <line x1="292" y1="125" x2="256" y2="140" stroke="#a78bfa" stroke-width="1.5" opacity="0.5"/>
  <!-- Text -->
  <text x="256" y="460" text-anchor="middle" font-family="Arial, sans-serif" font-weight="bold" font-size="42" fill="#f1f5f9">FitAI</text>
</svg>
